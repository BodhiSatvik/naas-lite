{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make test)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Edit(/factory/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/Makefile)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
